---
import { copyFor } from "../../i18n";
import Article from "../../layouts/Article.astro";
import { longDate, money, monthYear } from "../../lib/format";
import { percentIncrease, priceRises, yearlyIncrease } from "../../lib/priceRises";
import { type Locale, path } from "../../lib/site";
import CloseCard from "../CloseCard.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copyFor(locale);
const r = c.rises;
const percent = new Intl.NumberFormat(c.intl, { maximumFractionDigits: 1 });
const lastRead = priceRises.map((rise) => rise.read).sort().at(-1) ?? "";

const dated = (text: string, iso: string) => ({ text, iso });

const entries = priceRises.map((rise) => ({
  ...rise,
  price: `${money(rise.from, rise.currency)} → ${money(rise.to, rise.currency)}`,
  year: r.perYear(money(yearlyIncrease(rise), rise.currency)),
  percent: r.percent(percent.format(percentIncrease(rise))),
  when: [
    rise.announced
      ? dated(r.announced(longDate(locale, rise.announced)), rise.announced)
      : { text: r.noDate, iso: null },
    dated(r.onPage(longDate(locale, rise.onPricingPage)), rise.onPricingPage),
    ...(rise.existing
      ? [
          "after" in rise.existing
            ? dated(
                r.existingAfter(longDate(locale, rise.existing.after)),
                rise.existing.after,
              )
            : dated(
                r.existingMonth(monthYear(locale, rise.existing.month)),
                rise.existing.month,
              ),
        ]
      : []),
  ],
}));

// One section per service, in the log's own order, so a search for one
// service's rise lands on a heading that names it.
const services = [...new Set(entries.map((entry) => entry.service))].map(
  (service) => ({
    service,
    id: service.toLowerCase().replaceAll(" ", "-"),
    rows: entries.filter((entry) => entry.service === service),
  }),
);
---

<Article
  locale={locale}
  page="price-increases-2026"
  title={r.metaTitle}
  description={r.metaDescription}
  modified={lastRead}
>
  <div class="shell">
    <h1 class="a-title">{r.title}</h1>
    <p class="a-lead">{r.lead}</p>
    <p class="read">
      <time datetime={lastRead}>{r.read(longDate(locale, lastRead))}</time>
    </p>

    {
      services.map((group) => (
        <section class="svc" id={group.id} aria-labelledby={`${group.id}-title`}>
          <h2 class="svc__title" id={`${group.id}-title`}>
            {group.service}
          </h2>
          <table class="log">
            <thead>
              <tr>
                <th scope="col">{r.columns.service}</th>
                <th scope="col">{r.columns.price}</th>
                <th scope="col">{r.columns.year}</th>
                <th scope="col">{r.columns.when}</th>
                <th scope="col">{r.columns.sources}</th>
              </tr>
            </thead>
            <tbody>
              {group.rows.map((entry) => (
                <tr>
                  <th scope="row">
                    <span class="log__plan">{entry.plan}</span>
                    <span class="log__store">{r.storefront[entry.storefront]}</span>
                  </th>
                  <td class="log__price num" data-col={r.columns.price}>
                    {entry.price}
                  </td>
                  <td class="num" data-col={r.columns.year}>
                    {entry.year}
                    <span class="log__pct">{entry.percent}</span>
                  </td>
                  <td data-col={r.columns.when}>
                    <ul class="log__when">
                      {entry.when.map((line) => (
                        <li>
                          {line.iso ? <time datetime={line.iso}>{line.text}</time> : line.text}
                        </li>
                      ))}
                    </ul>
                  </td>
                  <td data-col={r.columns.sources}>
                    <ul class="log__sources">
                      {entry.sources.map((source) => (
                        <li>
                          <a class="link" href={source.url} rel="noopener">
                            {r.source[source.kind]}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))
    }
  </div>

  <section class="shell a-section" aria-labelledby="close-title">
    <CloseCard
      locale={locale}
      id="close-title"
      title={r.closeTitle}
      body={r.closeBody}
      href={`${path(locale)}#timeline`}
      link={r.closeLink}
      shot="price-rise"
      alt={c.hero.alt}
    />
  </section>
</Article>

<style>
  .read {
    margin-top: 1rem;
    font-size: var(--step-small);
    color: var(--text-muted);
  }

  .svc {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    scroll-margin-top: 5.5rem;
  }

  .svc__title {
    font-size: var(--step-lead);
    letter-spacing: -0.015em;
  }

  .log {
    margin-top: 0.75rem;
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 6px;
    text-align: left;
  }

  thead th {
    padding: 0 1.25rem 0.5rem;
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--text-muted);
  }

  tbody th,
  tbody td {
    padding: 1.1rem 1.25rem;
    vertical-align: top;
    background: var(--surface);
  }

  tbody th {
    border-radius: 18px 0 0 18px;
    font-weight: 400;
  }

  tbody td:last-child {
    border-radius: 0 18px 18px 0;
  }

  .log__plan {
    display: block;
    font-weight: 500;
  }

  .log__store {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--step-small);
    color: var(--text-muted);
  }

  .log__price {
    font-size: var(--step-lead);
    font-family: var(--display);
    white-space: nowrap;
  }

  .log__pct {
    display: block;
    font-size: var(--step-small);
    color: var(--text-muted);
  }

  .log__when,
  .log__sources {
    display: grid;
    gap: 0.25rem;
    font-size: var(--step-small);
  }

  @media (max-width: 63.99em) {
    .log,
    .log tbody,
    .log tr,
    .log th,
    .log td {
      display: block;
    }

    .log thead {
      display: none;
    }

    .log tr {
      margin-bottom: 8px;
      border-radius: 18px;
      overflow: hidden;
    }

    tbody th,
    tbody td,
    tbody td:last-child {
      border-radius: 0;
      padding-block: 0.6rem;
    }

    tbody th {
      padding-top: 1.1rem;
    }

    tbody td:last-child {
      padding-bottom: 1.1rem;
    }

    tbody td::before {
      content: attr(data-col);
      display: block;
      font-size: var(--step-small);
      font-weight: 500;
      color: var(--text-muted);
    }
  }
</style>
