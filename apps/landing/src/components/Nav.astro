---
import { copyFor } from "../i18n";
import { type Locale, otherLocale, path, type SitePage } from "../lib/site";
import Mark from "./Mark.astro";

interface Props {
  locale: Locale;
  page?: SitePage;
}

const { locale, page } = Astro.props;
const c = copyFor(locale);
const other = otherLocale(locale);
---

<div class="brandrow">
  <a class="brandrow__mark" href={path(locale)} aria-label="SubEye">
    <Mark height={22} />
  </a>
  <a
    class="brandrow__lang lang-link"
    href={path(other, page)}
    hreflang={other}
    lang={other}
    rel="alternate"
    aria-label={c.otherLangName}
  >
    {c.otherLangShort}
  </a>
</div>

<style>
  .brandrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.75rem;
  }

  .brandrow__mark {
    display: flex;
    color: var(--accent);
  }

  .brandrow__lang {
    font-size: var(--step-small);
    font-weight: 500;
    background: var(--surface-alt);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    transition: background-color 160ms var(--ease);
  }

  .brandrow__lang:hover {
    background: var(--ink-700);
  }
</style>
