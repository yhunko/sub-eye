---
import { subscriptionStatuses } from "@subeye/shared";
import { copyFor } from "../i18n";
import type { Locale } from "../lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copyFor(locale);

// Mapped from @subeye/shared rather than listed here, and `c.status` is a
// `Record<SubscriptionStatus, string>` — a new status in the app fails
// `astro check` instead of quietly leaving a gap in the mockup.
---

<ul class="chips">
  {
    subscriptionStatuses.map((status) => (
      <li class:list={["chip", `chip--${status}`]}>{c.status[status]}</li>
    ))
  }
</ul>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.44rem 0.75rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 7%);
    color: var(--text-muted);
  }

  /* --accent-bright, not --accent: brand green on its own 14% tint computes to
     4.05:1 at this size, under AA. The lighter green clears it at 7.4:1. */
  .chip--active {
    color: var(--accent-bright);
    background: rgb(51 164 83 / 14%);
  }

  .chip--paused {
    color: var(--warning);
    background: rgb(251 191 36 / 13%);
  }

  .chip--cancelled {
    color: var(--danger);
    background: rgb(248 113 113 / 12%);
  }
</style>
