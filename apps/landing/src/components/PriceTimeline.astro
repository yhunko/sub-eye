---
import type { PricePhaseKind } from "@subeye/model";
import { copyFor } from "../i18n";
import { money } from "../lib/format";
import type { Locale } from "../lib/site";
import { priceTimeline } from "../lib/timeline";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copyFor(locale);

const phaseLabel: Record<PricePhaseKind, string> = {
  trial: c.timeline.trial,
  intro: c.timeline.intro,
  scheduledChange: c.timeline.scheduledChange,
  standard: c.timeline.standard,
};

const top = Math.max(...priceTimeline.map((step) => step.monthly));

// Every number below comes out of @subeye/pricing at build time — see
// src/lib/timeline.ts. The bar heights are the prices themselves, over a floor
// tall enough to hold the free trial's words.
const steps = priceTimeline.map((step, i) => ({
  ...step,
  id: `phase-${i}`,
  label: phaseLabel[step.kind],
  blurb: c.timeline.blurb[step.kind],
  span:
    step.kind === "trial" && step.spanDays !== null
      ? c.timeline.days(step.spanDays)
      : step.spanMonths !== null
        ? c.timeline.months(step.spanMonths)
        : c.timeline.fromMonth(step.startMonth),
  amount: money(step.monthly, step.currency),
  yearly: step.monthly > 0 ? c.timeline.yearly(money(step.yearly, step.currency)) : null,
  height: (0.42 + 0.58 * (step.monthly / top)).toFixed(3),
}));
---

<fieldset class="tl">
  <legend class="sr-only">{c.timeline.title}</legend>
  <div class="tl__bars">
    {
      steps.map((step, i) => (
        <label class:list={["tl__bar", `tl__bar--${i}`]} style={`--h:${step.height}`}>
          <input
            class="tl__input"
            type="radio"
            name="phase"
            id={step.id}
            checked={step.isActive}
          />
          <span class="tl__price">
            <span class="tl__amount num">{step.amount}</span>
            <span class="tl__per">{c.timeline.perMonth}</span>
          </span>
          <span class="tl__when">
            {step.label} · {step.span}
          </span>
          <span class="tl__blurb">{step.blurb}</span>
          {step.yearly && <span class="tl__year num">{step.yearly}</span>}
        </label>
      ))
    }
  </div>
</fieldset>

<style>
  .tl {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .tl__bars {
    display: grid;
    gap: 8px;
    overflow: clip;
    overflow-clip-margin: 8px;
  }

  .tl__bar {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    border-radius: var(--radius);
    background: var(--surface-alt);
    color: var(--text);
    cursor: pointer;
    transition:
      background-color 240ms var(--ease),
      color 240ms var(--ease);
  }

  .tl__bar:hover {
    background: var(--ink-700);
  }

  .tl__bar:has(:checked) {
    background: var(--accent);
    color: var(--on-accent);
  }

  .tl__bar:has(:focus-visible) {
    outline: 2px solid var(--accent-bright);
    outline-offset: 3px;
  }

  /* The bar is the control; the radio stays focusable and arrow keys move
     between the three. */
  .tl__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .tl__when {
    font-weight: 500;
    font-size: var(--step-small);
  }

  /* The escalation is the argument, so it is in the type itself: the free
     trial at the lead step, the real price at the heading step, the intro
     between them. src/lib/timeline.ts guarantees exactly three phases. */
  .tl__amount {
    font-family: var(--display);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .tl__bar--0 .tl__amount {
    font-size: var(--step-lead);
  }

  .tl__bar--1 .tl__amount {
    font-size: calc(var(--step-head) * 0.78);
  }

  .tl__bar--2 .tl__amount {
    font-size: var(--step-head);
  }

  .tl__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.5rem;
  }

  .tl__per {
    font-size: var(--step-small);
  }

  .tl__blurb {
    font-size: var(--step-small);
    max-width: 30ch;
  }

  .tl__year {
    margin-top: auto;
    font-size: var(--step-small);
    font-weight: 500;
  }

  .tl__bar--0 {
    min-height: 9rem;
  }

  .tl__bar--1 {
    min-height: 12rem;
  }

  .tl__bar--2 {
    min-height: 16rem;
  }

  @media (min-width: 52em) {
    .tl__bars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: end;
      height: clamp(22rem, 28vw, 27rem);
    }

    .tl__bar {
      height: calc(var(--h) * 100%);
      min-height: 0;
    }
  }

  /* The page's one scroll-linked move: the three bars rise into place as they
     come into view, the tallest last. Text moves with its bar, so it is never
     drawn off its own fill. Browsers without scroll timelines draw them risen. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tl__bar {
        animation: tl-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 35%;
      }

      .tl__bar--1 {
        animation-range: entry 10% cover 42%;
      }

      .tl__bar--2 {
        animation-range: entry 20% cover 50%;
      }
    }
  }

  @keyframes tl-rise {
    from {
      transform: translateY(28%);
    }
  }
</style>
