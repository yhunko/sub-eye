---
import { copyFor } from "../i18n";
import { appStoreUrl, type Locale } from "../lib/site";

interface Props {
  locale: Locale;
  /** 40px is Apple's onscreen floor. Only the fixed bar has to go that low. */
  size?: "hero" | "bar";
  /** Centre the artwork in its box instead of pulling its clear space back
      into line with the text beside it. */
  centred?: boolean;
}

const { locale, size = "hero", centred = false } = Astro.props;
const c = copyFor(locale);
---

{/*
  Apple's own artwork, vendored byte-for-byte from
  https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg
  and served from this origin — the site references no third-party host at
  runtime, and `img-src 'self' data:` in public/_headers would block it anyway.

  It is the preferred black badge; the grey keyline is part of the artwork and
  the guidelines say not to touch it, so nothing here recolours, rounds, tilts
  or animates the image, and there is no hover state for the same reason.

  Apple's wording is "Use one App Store badge per layout or video", and this
  page carries three of them: the hero, the fixed bar and the closing card.
  That is a deliberate call and not an oversight — every route to the App Store
  on this site is Apple's badge or it is nothing, rather than a plain green
  button borrowing the badge's job. `test/appStore.test.ts` pins those three
  placements, so a fourth has to be argued for on purpose.

  English on both locales, deliberately. Apple publishes a Ukrainian badge —
  "Завантажити в App Store", with the service mark left in English — but that
  artwork is only distributed through App Store Marketing Tools, and the
  guidelines are explicit that you may never build your own localised badge. To
  ship the real one: download the Ukrainian black SVG, save it as
  `public/badges/download-on-the-app-store-uk.svg`, and choose the file by
  locale here. Until then the English badge is the compliant answer, not a
  shortcut.
*/}
<a
  class:list={[
    "appstore",
    `appstore--${size}`,
    { "appstore--centred": centred },
  ]}
  href={appStoreUrl}
>
  <img
    src="/badges/download-on-the-app-store.svg"
    alt={c.appStore.badgeAlt}
    width="120"
    height="40"
    fetchpriority="high"
  />
</a>

<style>
  /*
   * Clear space of at least a quarter of the badge height on every side, with
   * no type or graphics inside it, is the rule every size here has to keep.
   * Carrying it on the badge itself is what makes it survive a later change to
   * a parent's `gap`. The negative inline-start margin then pulls the artwork
   * back into line with whatever the badge sits under — the hero's headline,
   * the bar's own gutter — where the page already gives more clear space than
   * the rule asks for. In the closing card the badge is centred instead, and
   * that pull would put it off-centre by a quarter of its height.
   */
  .appstore {
    display: inline-block;
    padding: calc(var(--badge-h) / 4);
    margin-inline-start: calc(var(--badge-h) / -4);
  }

  .appstore--centred {
    margin-inline-start: 0;
  }

  /* 54px against Apple's 40px floor: it is the hero's primary action and it
     has to sit level with the ghost button beside it. */
  .appstore--hero {
    --badge-h: 3.375rem;
  }

  /* The floor exactly. 40px of artwork plus its 10px of clear space is 60 of
     the bar's 72 — anything larger stops being subordinate to the page and
     starts crowding the rule under it. */
  .appstore--bar {
    --badge-h: 2.5rem;
  }

  /* `height` + `aspect-ratio` rather than the intrinsic ratio, so the box is
     the right shape before the SVG has loaded and the row never shifts. */
  .appstore img {
    display: block;
    height: var(--badge-h);
    width: auto;
    aspect-ratio: 119.66407 / 40;
  }
</style>
