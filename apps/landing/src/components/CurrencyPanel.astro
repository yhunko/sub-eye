---
import { copyFor } from "../i18n";
import { currencyMockup } from "../lib/currencies";
import { money } from "../lib/format";
import type { Locale } from "../lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copyFor(locale);
const { rows, total, homeCurrency } = currencyMockup(locale);

// A row already denominated in the reader's own currency converts to itself and
// says nothing — the point of the panel is the arithmetic. The total is still
// the whole basket.
const converted = rows.filter((row) => row.currency !== homeCurrency);
---

<div class="fx" data-ui>
  <ul>
    {
      converted.map((row) => (
        <li class="fx__row num">
          <span class="fx__from">{row.name} · {money(row.amount, row.currency)}</span>
          <span>{money(row.converted, homeCurrency)}</span>
        </li>
      ))
    }
    <li class="fx__row fx__row--total">
      <span>{c.panel.totalThisMonth}</span>
      <span class="num">{money(total, homeCurrency)}</span>
    </li>
  </ul>
</div>

<style>
  .fx ul {
    display: grid;
    gap: 4px;
  }

  .fx__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    background: var(--surface-alt);
    font-size: var(--step-small);
  }

  .fx__row:first-child {
    border-radius: 16px 16px 4px 4px;
  }

  .fx__from {
    color: var(--text-muted);
  }

  .fx__row--total {
    background: var(--ink-700);
    border-radius: 4px 4px 16px 16px;
    font-weight: 500;
  }
</style>
