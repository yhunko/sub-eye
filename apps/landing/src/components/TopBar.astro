---
import { copyFor } from "../i18n";
import { type Locale, otherLocale, path, type SitePage } from "../lib/site";
import AppStoreBadge from "./AppStoreBadge.astro";
import Mark from "./Mark.astro";

interface Props {
  locale: Locale;
  /** Omitted on the home page, whose sections the links scroll to in place. */
  page?: SitePage;
}

const { locale, page } = Astro.props;
const c = copyFor(locale);
const other = otherLocale(locale);
const home = page ? path(locale) : "";
const links = [
  ["timeline", c.nav.timeline],
  ["free", c.nav.free],
  ["price", c.nav.price],
  ["faq", c.nav.faq],
] as const;
---

<header class="bar">
  <div class="shell bar__inner">
    <a class="bar__brand" href={page ? path(locale) : "#top"}>
      <Mark height={18} />
      <span>SubEye</span>
    </a>

    <nav class="bar__nav" aria-label="SubEye">
      {links.map(([id, label]) => <a class="bar__link" href={`${home}#${id}`}>{label}</a>)}
      <a
        class="bar__lang"
        href={path(other, page)}
        hreflang={other}
        lang={other}
        rel="alternate"
        aria-label={c.otherLangName}>{c.otherLangShort}</a
      >
      <AppStoreBadge locale={locale} size="bar" />
    </nav>
  </div>
</header>

<style>
  /* Opaque and visible from the first paint, so the badge is on screen before
     the reader scrolls. The page pads itself out from under it. */
  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    padding-top: 0.75rem;
  }

  .bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 3.75rem;
    padding-inline: 1.1rem 0.4rem;
    border-radius: 18px;
    background: var(--surface);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 7%);
  }

  .bar__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent);
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--step-body);
    letter-spacing: -0.01em;
  }

  .bar__brand span {
    color: var(--text);
  }

  .bar__nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    font-size: var(--step-small);
    font-weight: 500;
  }

  .bar__link {
    display: none;
    color: var(--text-muted);
    transition: color 160ms var(--ease);
  }

  .bar__link:hover {
    color: var(--text);
  }

  .bar__inner :global(.appstore) {
    margin-inline-start: 0;
  }

  .bar__lang {
    font-weight: 500;
    color: var(--text);
    background: var(--surface-alt);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    transition: background-color 160ms var(--ease);
  }

  .bar__lang:hover {
    background: var(--ink-700);
  }

  @media (min-width: 64em) {
    .bar__link {
      display: inline;
    }
  }
</style>
