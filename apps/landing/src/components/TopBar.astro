---
import { copyFor } from "../i18n";
import { type Locale, otherLocale, path } from "../lib/site";
import AppStoreBadge from "./AppStoreBadge.astro";
import Mark from "./Mark.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copyFor(locale);
const other = otherLocale(locale);
---

<header class="bar">
  <div class="shell bar__inner">
    <a class="bar__brand" href="#top" aria-label="SubEye">
      <Mark height={20} />
    </a>

    <nav class="bar__nav">
      <a class="bar__link" href="#how">{c.nav.how}</a>
      <a class="bar__link" href="#privacy">{c.nav.privacy}</a>
      <a class="bar__link" href="#price">{c.nav.price}</a>
      <a class="bar__link" href="#faq">{c.faq.title}</a>
      <span class="bar__rule" aria-hidden="true"></span>
      <a
        class="bar__lang"
        href={path(other)}
        hreflang={other}
        lang={other}
        rel="alternate"
        aria-label={c.otherLangName}>{c.otherLangShort}</a
      >
      <AppStoreBadge locale={locale} size="bar" />
    </nav>
  </div>
</header>

<style>
  /* Visible from the first paint, so the App Store badge is on screen before
     the reader scrolls. That makes this the page's only brand row — Home.astro
     drops the hero's duplicate and pads the hero out from under it. */
  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    /* Not `var(--bg)`: the bar is translucent over what scrolls under it. */
    background: rgb(15 17 21 / 86%);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--border);
  }

  .bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4.5rem;
  }

  .bar__brand {
    display: flex;
    color: var(--text);
  }

  .bar__nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    font-size: var(--fs-small);
    font-weight: 600;
  }

  /* Class, not `.bar__nav > a` — a descendant selector outranks `.bar__lang`
     and repaints the language pill on hover along with the links. */
  .bar__link {
    color: var(--text-muted);
    transition: color 160ms var(--ease);
  }

  .bar__link:hover {
    color: var(--text);
  }

  .bar__rule {
    width: 1px;
    height: 1.25rem;
    background: var(--border);
  }

  .bar__lang {
    font-size: var(--fs-tiny);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.6rem;
    transition:
      color 160ms var(--ease),
      border-color 160ms var(--ease);
  }

  .bar__lang:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  /* Four anchors do not fit next to a price at 375px, and the sections they
     point at are one scroll away regardless. */
  .bar__link,
  .bar__rule {
    display: none;
  }

  @media (min-width: 60em) {
    .bar__link {
      display: inline;
    }

    .bar__rule {
      display: block;
    }
  }
</style>
