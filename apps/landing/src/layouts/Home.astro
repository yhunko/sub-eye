---
import AppShot from "../components/AppShot.astro";
import AppStoreBadge from "../components/AppStoreBadge.astro";
import CurrencyPanel from "../components/CurrencyPanel.astro";
import Footer from "../components/Footer.astro";
import Phone from "../components/Phone.astro";
import PriceTimeline from "../components/PriceTimeline.astro";
import TopBar from "../components/TopBar.astro";
import { copyFor } from "../i18n";
import { money } from "../lib/format";
import type { Locale } from "../lib/site";
import { path, proPrice, proPriceUkraine } from "../lib/site";
import Base from "./Base.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copyFor(locale);

const us = { price: money(proPrice.usd, "usd"), where: c.pricing.storefrontUs };
const ua = { price: money(proPriceUkraine, "usd"), where: c.pricing.storefrontUa };
const eu = { price: money(proPrice.eur, "eur"), where: c.pricing.storefrontEu };

// A visitor on the Ukrainian storefront should see their own price first — the
// whole point of the per-storefront line is that it is their price, not a conversion.
const home = locale === "uk" ? ua : us;
const storefronts = locale === "uk" ? [ua, us, eu] : [us, ua, eu];
// "Free" priced in the reader's own currency, not a dollar zero on a hryvnia page.
const free = money(0, locale === "uk" ? "uah" : "usd", 0);
---

<Base
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  structuredData
>
  {/*
    StartupBar's directory widget. The only third-party origin this site loads
    at runtime and the only JavaScript it ships, so `script-src`, `frame-src`
    and `img-src` in public/_headers each name startupbar.co — the loader
    injects an iframe and an image-pixel heartbeat, and the CSP blocks all three
    silently if one is missing. The home pages only: the legal URLs are App
    Store Connect metadata a reviewer opens.

    It owns the very top of the viewport, pads the body out from under itself
    and pushes any `position: fixed; top: 0` element down by its own height —
    which is how the bar below survives it without a media query here.
  */}
  <script
    is:inline
    async
    src="https://startupbar.co/widget/loader.js"
    data-startup-id="5bebca65-f371-43e4-81c9-3475815f2c94"></script>

  <TopBar locale={locale} />

  <main id="main">
    <section class="hero" id="top">
      <div class="shell hero__grid">
        <div class="hero__copy">
          <h1 class="hero__title">{c.hero.title}</h1>
          <p class="hero__lead">{c.hero.lead}</p>
          <div class="hero__actions">
            <AppStoreBadge locale={locale} />
            <a class="hero__more" href="#timeline">{c.hero.secondary} <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero__price">{c.hero.price(home.price)}</p>
        </div>
        <div class="hero__device">
          <Phone locale={locale} shot="price-rise" alt={c.hero.alt} width={400} priority />
        </div>
      </div>
    </section>

    <section class="sec" id="timeline" aria-labelledby="timeline-title">
      <div class="shell split">
        <div class="split__text">
          <h2 class="h2" id="timeline-title">{c.timeline.title}</h2>
          <p class="lead">{c.timeline.lede}</p>
          <PriceTimeline locale={locale} />
          <div class="note">
            <h3 class="h3">{c.timeline.proTitle}</h3>
            <p>{c.timeline.pro(home.price)}</p>
          </div>
        </div>
        <div class="split__device">
          <Phone locale={locale} shot="timeline" alt={c.timeline.shotAlt} width={360} />
        </div>
      </div>
    </section>

    <section class="sec" id="free" aria-labelledby="free-title">
      <div class="shell">
        <div class="head-row">
          <h2 class="h2" id="free-title">{c.free.title}</h2>
          <p class="lead">{c.free.body}</p>
        </div>
        <div class="free">
          <ul class="features">
            {
              c.free.features.map((feature) => (
                <li>
                  <h3 class="h3">{feature.title}</h3>
                  <p>{feature.body}</p>
                </li>
              ))
            }
            <li class="features__fx">
              <h3 class="h3">{c.does.currency.title}</h3>
              <p>{c.does.currency.body}</p>
              <CurrencyPanel locale={locale} />
            </li>
          </ul>
          <div class="panel free__panel">
            <Phone locale={locale} shot="home" alt={c.free.shotAlt} width={340} />
          </div>
        </div>
      </div>
    </section>

    <section class="sec" id="installments" aria-labelledby="inst-title">
      <div class="shell">
        <div class="card inst">
          <div class="inst__devices">
            <Phone locale={locale} shot="calendar" alt={c.installments.calendarAlt} width={260} class="inst__cal" />
            <Phone locale={locale} shot="installments" alt={c.installments.plansAlt} width={260} class="inst__list" />
          </div>
          <div class="inst__text">
            <h2 class="h2" id="inst-title">{c.installments.title}</h2>
            <p class="lead">{c.installments.body}</p>
            <AppShot locale={locale} shot="day" alt={c.installments.dayAlt} width={440} class="inst__day" />
            <p class="small">{c.installments.note}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="sec" id="reminders" aria-labelledby="rem-title">
      <div class="shell split split--flip">
        <div class="split__text">
          <h2 class="h2" id="rem-title">{c.reminders.title}</h2>
          <p class="lead">{c.reminders.body}</p>
          <div class="note">
            <p>{c.reminders.pro}</p>
          </div>
        </div>
        <div class="split__device">
          <Phone locale={locale} shot="live-activity" alt={c.reminders.alt} width={360} />
        </div>
      </div>
    </section>

    <section class="sec" id="privacy" aria-labelledby="privacy-title">
      <div class="shell privacy">
        <div class="privacy__head">
          <h2 class="h2" id="privacy-title">{c.privacy.title}</h2>
          <p class="lead">{c.privacy.body}</p>
          <a class="link" href={path(locale, "privacy-policy")}>{c.privacy.policy}</a>
        </div>
        <ul class="privacy__rows">
          {
            c.privacy.rows.map((row) => (
              <li>
                <span class="pupil" aria-hidden="true" />
                <div>
                  <h3 class="h3">{row.title}</h3>
                  <p>{row.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="sec" id="price" aria-labelledby="price-title">
      <div class="shell">
        <div class="head-row">
          <h2 class="h2" id="price-title">{c.pricing.title}</h2>
          <p class="lead">{c.pricing.joke}</p>
        </div>
        <div class="plans">
          <div class="card plan">
            <h3 class="h3">{c.pricing.freeName}</h3>
            <p class="plan__price"><span class="num">{free}</span> <span class="plan__per">{c.pricing.freeSuffix}</span></p>
            <ul class="pupil-list plan__items">
              {c.pricing.freeItems.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="card plan plan--pro">
            <h3 class="h3">{c.pricing.proName}</h3>
            <p class="plan__price"><span class="num">{home.price}</span> <span class="plan__per">{c.pricing.proSuffix}</span></p>
            <ul class="pupil-list plan__items">
              {c.pricing.proItems.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
        <div class="stores">
          <div>
            <h3 class="h3">{c.pricing.storefrontTitle}</h3>
            <p>{c.pricing.storefrontBody}</p>
          </div>
          <ul class="stores__list">
            {
              storefronts.map((s) => (
                <li>
                  <span class="num">{s.price}</span>
                  <span class="muted">{s.where}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="sec" id="faq" aria-labelledby="faq-title">
      <div class="shell faq">
        <h2 class="h2" id="faq-title">{c.faq.heading}</h2>
        <div class="faq__list">
          {
            c.faq.items.map((item) => (
              <details class="faq__item" name="faq">
                <summary>
                  <span>{item.q}</span>
                  <span class="faq__sign" aria-hidden="true" />
                </summary>
                <p class="faq__answer">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sec sec--last" aria-labelledby="end-title">
      <div class="shell">
        <div class="card end">
          <div class="end__text">
            <h2 class="h2" id="end-title">{c.cta.title}</h2>
            <p class="lead">{c.cta.body}</p>
            <p>{c.cta.fact(home.price)}</p>
            <AppStoreBadge locale={locale} />
          </div>
          <div class="end__device">
            <Phone locale={locale} shot="subscriptions" alt={c.free.shotAlt} width={280} />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</Base>

<style>
  .h2 {
    font-size: var(--step-head);
  }

  .h3 {
    font-family: var(--sans);
    font-weight: 500;
    font-size: var(--step-body);
    letter-spacing: 0;
    line-height: 1.3;
  }

  .lead {
    font-size: var(--step-lead);
    line-height: 1.4;
    color: var(--text-muted);
  }

  .small {
    font-size: var(--step-small);
    color: var(--text-muted);
  }

  .card,
  .panel {
    border-radius: var(--radius);
    background: var(--surface);
  }

  .sec {
    padding-block: clamp(5rem, 9vw, 8rem);
  }

  /* ---------- hero ---------- */

  .hero {
    padding-top: calc(4.5rem + clamp(2.5rem, 7vh, 5rem));
    overflow: clip;
    background:
      radial-gradient(50% 50% at 75% 85%, rgb(51 164 83 / 20%), transparent 70%),
      var(--bg);
  }

  .hero__grid {
    display: grid;
    gap: 2.5rem;
  }

  .hero__copy {
    display: grid;
    justify-items: center;
    align-content: center;
    text-align: center;
  }

  .hero__copy > * {
    animation: rise 700ms var(--ease-out) both;
  }

  .hero__title {
    font-size: var(--step-display);
    max-width: 19ch;
  }

  .hero__lead {
    margin-top: 1.5rem;
    max-width: 40ch;
    font-size: var(--step-lead);
    line-height: 1.4;
    color: var(--text-muted);
    animation-delay: 80ms;
  }

  .hero__actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 1.5rem;
    animation-delay: 160ms;
  }

  /* Centred on a phone, the badge's clear space stays on both sides instead
     of being pulled into line with a left edge that is not there. */
  .hero__actions :global(.appstore) {
    margin-inline-start: 0;
  }

  .hero__more {
    font-weight: 500;
    padding: 0.5rem 0;
    transition: color 160ms var(--ease);
  }

  .hero__more span {
    display: inline-block;
    transition: transform 200ms var(--ease);
  }

  .hero__more:hover {
    color: var(--accent-bright);
  }

  .hero__more:hover span {
    transform: translateY(3px);
  }

  .hero__price {
    margin-top: 0.75rem;
    font-size: var(--step-small);
    color: var(--text-muted);
    animation-delay: 240ms;
  }

  .hero__device {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-bottom: 3rem;
    animation: rise 1s var(--ease-out) 200ms both;
  }

  .hero__device :global(.phone) {
    --w: 300px !important;
  }

  @media (min-width: 64em) {
    .hero {
      height: 100svh;
      min-height: 48rem;
    }

    .hero__grid {
      grid-template-columns: 8fr 4fr;
      gap: 3rem;
      height: 100%;
    }

    .hero__copy {
      justify-items: start;
      text-align: left;
    }

    .hero__actions {
      justify-content: flex-start;
    }

    .hero__actions :global(.appstore) {
      margin-inline-start: calc(var(--badge-h) / -4);
    }

    /* The whole phone fits the first screen at any height: its width follows
       the viewport's height (a screen is 2.17 times as tall as it is wide). */
    .hero__device {
      padding-bottom: 0;
    }

    .hero__device :global(.phone) {
      --w: min(400px, calc((100svh - 10rem) * 0.44)) !important;
    }
  }

  /* ---------- splits ---------- */

  .split {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .split__text {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .split__device {
    display: flex;
    justify-content: center;
  }

  .note {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: 20px;
    background: var(--surface);
  }

  @media (min-width: 64em) {
    .split {
      grid-template-columns: 7fr 5fr;
      gap: 5rem;
    }

    .split--flip {
      grid-template-columns: 5fr 7fr;
    }

    .split--flip .split__device {
      order: -1;
    }
  }

  /* ---------- free ---------- */

  .head-row {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .free {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .features {
    display: grid;
    gap: 2rem 2.5rem;
  }

  .features li {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .features p {
    color: var(--text-muted);
  }

  .features__fx {
    margin-top: 0.5rem;
  }

  .free__panel {
    display: flex;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem) 1rem;
  }

  @media (min-width: 52em) {
    .head-row {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: end;
    }

    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .features__fx {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64em) {
    .free {
      grid-template-columns: 7fr 5fr;
      gap: 4rem;
    }
  }

  /* ---------- installments ---------- */

  .inst {
    display: grid;
    overflow: hidden;
  }

  .inst__devices {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 3rem) 1rem;
    background: var(--surface-alt);
  }

  .inst__devices :global(.inst__list) {
    display: none;
  }

  .inst__text {
    display: grid;
    gap: 1.5rem;
    align-content: center;
    padding: clamp(1.75rem, 4vw, 3.5rem);
  }

  .inst__text :global(.inst__day) {
    width: 100%;
    height: auto;
    border-radius: 20px;
  }

  @media (min-width: 40em) {
    .inst__devices :global(.inst__list) {
      display: block;
      margin-top: 3rem;
    }
  }

  @media (min-width: 64em) {
    .inst {
      grid-template-columns: 6fr 5fr;
    }

    .inst__devices {
      align-items: center;
    }
  }

  /* ---------- privacy ---------- */

  .privacy {
    display: grid;
    gap: 3rem;
  }

  .privacy__head {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    justify-items: start;
  }

  .privacy__rows {
    display: grid;
    gap: 2rem;
  }

  .privacy__rows li {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1rem;
  }

  .privacy__rows p {
    margin-top: 0.3rem;
    color: var(--text-muted);
  }

  /* The pupil of the app icon marks each promise. */
  .pupil {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 14px;
    background: var(--surface);
  }

  .pupil::after {
    content: "";
    position: absolute;
    inset: 0.8rem;
    background: var(--accent);
    mask: var(--pupil) center / contain no-repeat;
  }

  @media (min-width: 64em) {
    .privacy {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
    }
  }

  /* ---------- price ---------- */

  .plans {
    display: grid;
    gap: 1rem;
  }

  .plan {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .plan--pro {
    background: var(--green-700);
  }

  .plan__price {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .plan__price .num {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--step-head);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .plan__per {
    color: var(--text-muted);
  }

  .plan--pro .plan__per {
    color: var(--text);
  }

  .plan__items {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .plan--pro :global(.pupil-list li)::before {
    background: var(--accent-bright);
  }

  .stores {
    margin-top: 1rem;
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .stores p {
    margin-top: 0.3rem;
    color: var(--text-muted);
    max-width: 52ch;
  }

  .stores__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  .stores__list li {
    display: grid;
  }

  .stores__list .num {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--step-lead);
  }

  @media (min-width: 52em) {
    .plans {
      grid-template-columns: 1fr 1fr;
    }

    .stores {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  /* ---------- faq ---------- */

  .faq {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .faq__list {
    display: grid;
    gap: 8px;
  }

  .faq__item {
    border-radius: 20px;
    background: var(--surface);
    transition: background-color 200ms var(--ease);
  }

  .faq__item:hover,
  .faq__item[open] {
    background: var(--surface-alt);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.25rem;
    padding: 1rem 1.5rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary:focus-visible {
    outline-offset: -4px;
  }

  /* Two bars drawn instead of a "+" glyph, so opening rotates one of them
     rather than swapping a character and reflowing the row. */
  .faq__sign {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .faq__sign::before,
  .faq__sign::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    border-radius: 2px;
    background: var(--accent-bright);
    transform: translateY(-50%);
  }

  .faq__sign::after {
    transition: transform 240ms var(--ease);
    transform: translateY(-50%) rotate(90deg);
  }

  .faq__item[open] .faq__sign::after {
    transform: translateY(-50%) rotate(0deg);
  }

  /* A grid item's automatic minimum size is its content, which would hold the
     0fr row open. These two are what let the row actually collapse. */
  .faq__answer {
    min-height: 0;
    overflow: hidden;
    padding: 0 1.5rem 1.5rem;
    max-width: 64ch;
    color: var(--text-muted);
  }

  /*
   * The accordion, with no JavaScript and no layout thrash: `::details-content`
   * is the open/closed box itself, so the panel is a grid row animating 0fr→1fr
   * and the answer never re-wraps mid-transition. `content-visibility` has to
   * transition discretely or the closing frame is skipped and the panel snaps.
   * Browsers without `::details-content` simply open instantly.
   */
  .faq__item::details-content {
    display: grid;
    grid-template-rows: 0fr;
    overflow: clip;
    opacity: 0;
    transition:
      grid-template-rows 260ms var(--ease),
      opacity 180ms var(--ease),
      content-visibility 260ms allow-discrete;
  }

  .faq__item[open]::details-content {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  @media (min-width: 64em) {
    .faq {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
    }
  }

  /* ---------- the close ---------- */

  .sec--last {
    padding-bottom: 0;
  }

  .end {
    display: grid;
    overflow: hidden;
  }

  .end__text {
    display: grid;
    gap: 1.25rem;
    align-content: center;
    justify-items: start;
    padding: clamp(1.75rem, 5vw, 4rem);
  }

  .end__device {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2.5rem 1rem;
    background: var(--green-700);
  }

  @media (min-width: 64em) {
    .end {
      grid-template-columns: 1fr 1fr;
    }

    .end__device {
      padding-block: 3.5rem;
    }
  }
</style>
