---
import { copyFor } from "../i18n";
import { ogCard } from "../lib/og";
import {
  APP_STORE_ID,
  canonical,
  type Locale,
  locales,
  otherLocale,
  SITE,
  type SitePage,
} from "../lib/site";
import "../styles/global.css";

interface Props {
  locale: Locale;
  page?: SitePage;
  title: string;
  description: string;
  /** A schema.org graph. The home and content pages carry one; the legal pages are documents. */
  jsonLd?: Record<string, unknown>;
  /** ISO day an article was last revised; marks the page `og:type` article. */
  modified?: string;
}

const { locale, page, title, description, jsonLd, modified } = Astro.props;
const c = copyFor(locale);
const card = ogCard(locale, page);
const fontSubset = locale === "uk" ? "cyrillic" : "latin";
---

<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="max-image-preview:large" />
    <meta name="theme-color" content="#0f1115" />
    <meta name="color-scheme" content="dark" />

    {/* Safari draws this one itself, on iPhone and iPad only — no other browser
        renders it and nothing on the page can style it. The app is iOS-only, so
        the reader who can actually install it gets Apple's native offer above
        everything else; every other reader gets the fixed bar's badge. */}
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />

    <link rel="canonical" href={canonical(locale, page)} />
    {
      locales.map((alt) => (
        <link rel="alternate" hreflang={alt} href={canonical(alt, page)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={canonical("en", page)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* The h1 is the LCP element and is set in the display face; the body face
        is preloaded too so running text does not reflow when it swaps in. Only
        the subset this locale paints is worth the request. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`/fonts/fixeldisplay-semibold-${fontSubset}.woff2`}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`/fonts/fixeltext-regular-${fontSubset}.woff2`}
      crossorigin
    />

    <meta property="og:type" content={modified ? "article" : "website"} />
    <meta property="og:site_name" content="SubEye" />
    <meta property="og:locale" content={locale === "uk" ? "uk_UA" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={otherLocale(locale) === "uk" ? "uk_UA" : "en_US"}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical(locale, page)} />
    <meta property="og:image" content={`${SITE}${card.path}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={card.alt} />
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={card.alt} />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>

  <body>
    <a class="skip" href="#main">{c.skip}</a>
    <slot />
  </body>
</html>
