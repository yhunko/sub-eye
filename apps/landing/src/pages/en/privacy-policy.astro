---
import { getLegalDoc } from "@subeye/legal";
import LegalBody from "../../components/LegalBody.astro";
import Legal from "../../layouts/Legal.astro";

const doc = getLegalDoc("privacy-policy", "en");
---

<Legal
  locale="en"
  page="privacy-policy"
  title={doc.title}
  description={doc.description}
  updated={doc.updated}
>
  <LegalBody doc={doc} locale="en" />
</Legal>
