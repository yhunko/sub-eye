---
import { getLegalDoc } from "@subeye/legal";
import LegalBody from "../../components/LegalBody.astro";
import Legal from "../../layouts/Legal.astro";

const doc = getLegalDoc("terms-of-service", "uk");
---

<Legal
  locale="uk"
  page="terms-of-service"
  title={doc.title}
  description={doc.description}
  updated={doc.updated}
>
  <LegalBody doc={doc} locale="uk" />
</Legal>
