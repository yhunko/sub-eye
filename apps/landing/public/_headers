# One site-wide policy: Cloudflare applies every matching block, so a second
# Content-Security-Policy header would be intersected with this one, not
# replace it. The site ships no JavaScript and loads nothing from another
# origin, so scripts and frames are refused outright — the JSON-LD block is
# data, which a CSP does not govern.
/*
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Apple's badge artwork, vendored and never edited in place — a reissued badge
# arrives under a new filename, so this can be cached like the fonts.
/badges/*
  Cache-Control: public, max-age=31536000, immutable

# Astro's build output: every file name carries a content hash, so a changed
# image or stylesheet is a new URL and the old one can be cached for good.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
