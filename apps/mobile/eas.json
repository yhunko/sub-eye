{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "env": { "SUBEYE_BETA_VERSION": "4.0.0" },
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "env": { "SUBEYE_BETA_VERSION": "4.0.0" },
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "Z6KADG969Z"
      }
    }
  }
}
