# Origin of the SubEye Worker (no trailing slash, no /api suffix).
# For on-device dev this MUST be LAN-reachable or a tunnel — never localhost,
# because the request originates on the phone, not on your Mac.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8787
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# OPTIONAL. Brand search in the add/edit form (developers.brandfetch.com — the
# client id is public by design). The endpoint answers anonymous requests today,
# so search works without this; set it anyway, because the parameter is
# documented as required and the fallback is typing a domain by hand.
EXPO_PUBLIC_BRANDFETCH_CLIENT_ID=
