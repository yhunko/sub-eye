{
  "name": "@subeye/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "eas-build-post-install": "bun run i18n:generate",
    "i18n:generate": "bunx --bun @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/shared/i18n/paraglide --strategy globalVariable baseLocale --emit-ts-declarations --no-emit-git-ignore --no-emit-prettier-ignore --no-emit-readme",
    "start": "bun run i18n:generate && expo start",
    "ios": "bun run i18n:generate && expo run:ios",
    "android": "bun run i18n:generate && expo run:android",
    "prebuild": "expo prebuild --clean",
    "lint": "biome check .",
    "type-check": "bun run i18n:generate && tsc --noEmit --pretty",
    "test": "bun test ./src"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@sentry/react-native": "~7.11.0",
    "@subeye/legal": "workspace:*",
    "@subeye/lifecycle": "workspace:*",
    "@subeye/model": "workspace:*",
    "@subeye/money": "workspace:*",
    "@subeye/reminders": "workspace:*",
    "@subeye/store": "workspace:*",
    "@subeye/time": "workspace:*",
    "@tanstack/react-query": "^5.100.10",
    "date-fns": "^4.1.0",
    "expo": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.7",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-purchases": "^10.4.4",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.18.0",
    "@types/react": "~19.2.4"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
