{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",

    "types": ["bun-types", "@cloudflare/workers-types"],

    // Emits dist/src/*.d.ts so consumers (Expo/Metro) typecheck against types
    // instead of dragging 82 server source files into their program. This is
    // the ONE exception to the monorepo's source-only packaging rule.
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "emitDecoratorMetadata": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "strict": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*.test.ts"]
}
