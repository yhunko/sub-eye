{
  "name": "@subeye/server",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./client": {
      "types": "./dist/src/client.d.ts",
      "default": "./dist/src/client.js"
    }
  },
  "dependencies": {
    "@clerk/hono": "^0.1.13",
    "@hono/valibot-validator": "^0.6.1",
    "@neondatabase/serverless": "^1.0.2",
    "@subeye/money": "workspace:*",
    "@subeye/pricing": "workspace:*",
    "@subeye/model": "workspace:*",
    "@subeye/spend": "workspace:*",
    "@subeye/time": "workspace:*",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.14",
    "svix": "^1.90.0",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@clerk/express": "^2.1.2",
    "@types/bun": "^1.3.12",
    "drizzle-kit": "^0.31.10"
  },
  "scripts": {
    "check-env": "bun ./scripts/check-env.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:reset-ledger": "bun --env-file=.env ./scripts/db-reset-ledger.ts",
    "db:backfill-users": "bun --env-file=.env ./scripts/backfill-users-from-clerk.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:sql": "bun --env-file=.env ./scripts/db-sql.ts",
    "build": "tsc -p tsconfig.json",
    "dev": "bun --watch run src/index.ts & tsc --watch",
    "dev:lan": "WRANGLER_SEND_METRICS=false wrangler dev -c dev.wrangler.jsonc --ip 0.0.0.0 --port 8788",
    "lint": "biome check .",
    "test": "DATABASE_URL=${DATABASE_URL:-postgres://placeholder:placeholder@localhost/placeholder} bun test ./test",
    "type-check": "tsc -p tsconfig.json --pretty"
  }
}
