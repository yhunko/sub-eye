{
  "name": "@subeye/server",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./client": "./src/client.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.2",
    "@clerk/hono": "^0.1.13",
    "@hono/valibot-validator": "^0.6.1",
    "@neondatabase/serverless": "^1.0.2",
    "@subeye/shared": "workspace:*",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.14",
    "svix": "^1.90.0",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "drizzle-kit": "^0.31.10"
  },
  "scripts": {
    "check-env": "bun ./scripts/check-env.ts",
    "db:generate": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "dev": "bun --watch run src/index.ts & tsc --watch",
    "lint": "biome check .",
    "test": "bun test ./test",
    "type-check": "tsc --noEmit --pretty"
  }
}
