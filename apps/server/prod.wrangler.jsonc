{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "subeye",
  "main": "./src/index.ts",
  "compatibility_date": "2025-05-25",
  "route": {
    "pattern": "app.subeye.cc",
    "custom_domain": true
  },
  "tsconfig": "../../tsconfig.json",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  // `enabled` is the master switch and `logs.enabled` was true underneath it.
  // Wrangler does not reconcile the two — it posts this block verbatim and lets
  // the Workers API decide — so "does production keep logs?" was a question only
  // an incident would answer. Both true, traces off: unambiguous, and traces are
  // the part that is not free at any real volume.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
