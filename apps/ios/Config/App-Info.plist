<key>SubEyeAppGroup</key><string>group.cc.subeye.app</string>
<key>SubEyeNamespace</key><string>$(SUBEYE_NAMESPACE)</string>
<key>SubEyeURLScheme</key><string>$(SUBEYE_SCHEME)</string>
<key>SubEyeWidgetKey</key><string>$(SUBEYE_WIDGET_KEY)</string>
<key>RevenueCatAPIKey</key><string>$(REVENUECAT_API_KEY)</string>
<key>BrandfetchClientID</key><string>$(BRANDFETCH_CLIENT_ID)</string>
</dict></plist>
