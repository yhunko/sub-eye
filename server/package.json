    "@upstash/workflow": "^1.1.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.10.8",
    "shared": "workspace:*",
    "valibot": "^1.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.8"
