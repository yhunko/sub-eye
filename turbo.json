{
  "$schema": "https://v2-8-1.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.js",
        "src/**/*.jsx",
        "src/**/*.json",
        "src/**/*.astro",
        "src/**/*.css",
        "src/**/*.md",
        "public/**",
        "astro.config.*",
        "wrangler.jsonc",
        "tsconfig.json",
        "package.json",
        "bun.lock"
      ],
      "outputs": ["dist/**", "build/**", ".turbo/**"],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.js",
        "src/**/*.jsx",
        "src/**/*.astro",
        "src/**/*.css",
        "astro.config.*",
        "tsconfig.json",
        "package.json"
      ],
      "env": ["NODE_ENV", "PORT"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.d.ts",
        "src/**/*.astro",
        "src/**/*.css",
        "astro.config.*",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["dist/**/*.d.ts", ".tsbuildinfo"],
      "env": ["NODE_ENV"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.js",
        "src/**/*.jsx",
        "test/**/*.ts",
        "test/**/*.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "src/pages/**",
        "astro.config.*",
        "bunfig.toml",
        "test-preload.ts",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": ["coverage/**", ".nyc_output/**", "test-results/**"],
      "env": ["NODE_ENV", "CI"]
    }
  },
  "globalDependencies": [
    "**/.env",
    "**/.env.*",
    "**/.env.local",
    "**/.env.*.local",
    ".gitignore",
    "turbo.json",
    "package.json",
    "bun.lock",
    "tsconfig.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "TURBO_TOKEN",
    "TURBO_TEAM",
    "TURBO_REMOTE_ONLY"
  ]
}
