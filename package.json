{
  "name": "sub-eye",
  "description": "A monorepo template for SubEye subscriptions management app",
  "version": "3.7.0-beta.1",
  "author": "Yehor Hunko",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "bun-types": "^1.3.11",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "semantic-release": "^25.0.3",
    "syncpack": "^14.2.1",
    "turbo": "^2.8.20",
    "wrangler": "^4.77.0"
  },
  "homepage": "https://github.com/yhunko/sub-eye",
  "keywords": [
    "bun",
    "hono",
    "monorepo",
    "react",
    "turbo",
    "vite"
  ],
  "license": "MIT",
  "packageManager": "bun@1.3.10",
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:client": "turbo build --filter=client",
    "build:server": "turbo build --filter=server",
    "check:circular": "bun run check:circular:client && bun run check:circular:server",
    "check:circular:client": "madge --circular --extensions ts,tsx --ts-config client/tsconfig.app.json client/src",
    "check:circular:server": "madge --circular --extensions ts,tsx server/src",
    "deploy:dev": "turbo build && wrangler -c dev.wrangler.jsonc deploy --minify",
    "deps:fix": "syncpack fix-mismatches",
    "deps:format": "syncpack format",
    "deps:lint": "syncpack lint",
    "deps:majors": "bun x npm-check-updates --workspaces --root --format group",
    "deps:update": "bun x npm-check-updates --workspaces --root --target minor -u && bun install && bun run deps:fix",
    "deps:up": "bun x npm-check-updates --workspaces --root --interactive",
    "dev": "turbo dev",
    "dev:client": "turbo dev --filter=client",
    "dev:server": "turbo dev --filter=server",
    "guidelines:check": "bun scripts/sync-agent-guidelines.mjs --check",
    "guidelines:sync": "bun scripts/sync-agent-guidelines.mjs",
    "lint": "turbo lint",
    "postinstall": "turbo build --filter=shared --filter=server",
    "prepare": "husky",
    "react-doctor": "bun x react-doctor@latest . --yes --project client --diff --offline --fail-on warning --verbose",
    "test": "turbo test",
    "type-check": "turbo type-check"
  },
  "workspaces": [
    "./server",
    "./client",
    "./shared"
  ]
}
