{
  "name": "sub-eye",
  "description": "A monorepo template for SubEye subscriptions management app",
  "version": "3.12.0-beta.3",
  "author": "Yehor Hunko",
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@cloudflare/workers-types": "^4.20260415.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "bun-types": "^1.3.12",
    "dependency-cruiser": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "semantic-release": "^25.0.3",
    "syncpack": "^14.3.0",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.83.0"
  },
  "homepage": "https://github.com/yhunko/sub-eye",
  "keywords": [
    "bun",
    "expo",
    "hono",
    "monorepo",
    "turbo"
  ],
  "license": "MIT",
  "packageManager": "bun@1.3.12",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check:boundaries": "depcruise --config dependency-cruiser.cjs apps packages",
    "check:circular": "bun run check:circular:server && bun run check:circular:packages && bun run check:circular:mobile",
    "check:circular:server": "madge --circular --extensions ts,tsx apps/server/src",
    "check:circular:packages": "madge --circular --extensions ts packages/currency/src packages/pricing/src packages/shared/src packages/spend/src",
    "check:circular:mobile": "madge --circular --extensions ts,tsx --ts-config apps/mobile/tsconfig.json apps/mobile/src",
    "deploy:dev": "turbo build && wrangler -c apps/server/dev.wrangler.jsonc deploy --minify",
    "deps:fix": "syncpack fix",
    "deps:format": "syncpack format",
    "deps:lint": "syncpack lint",
    "deps:majors": "bun x npm-check-updates --workspaces --root --format group",
    "deps:update": "bun x npm-check-updates --workspaces --root --target minor -u && bun install && bun run deps:fix",
    "deps:up": "bun x npm-check-updates --workspaces --root --interactive",
    "dev": "turbo dev",
    "dev:server": "turbo dev --filter=@subeye/server",
    "dev:mobile": "bun run --cwd apps/server build && bun run --cwd apps/mobile start",
    "dev:lan": "bun run --cwd apps/server dev:lan",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky",
    "test": "turbo test",
    "type-check": "turbo type-check"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
