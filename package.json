{
  "name": "sub-eye",
  "description": "SubEye — subscription tracking: the native iOS app and the subeye.cc site",
  "version": "5.1.0-beta.1",
  "author": "Yehor Hunko",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "bun-types": "^1.4.2",
    "dependency-cruiser": "^18.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "madge": "^8.0.0",
    "semantic-release": "^25.0.9",
    "syncpack": "^15.3.3",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.129.0"
  },
  "homepage": "https://github.com/yhunko/sub-eye",
  "keywords": [
    "bun",
    "monorepo",
    "swiftui",
    "turbo"
  ],
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:ios": "bash apps/ios/scripts/build-ipa.sh",
    "check:boundaries": "depcruise --config dependency-cruiser.cjs apps packages",
    "check:circular": "bun run check:circular:packages && bun run check:circular:landing",
    "check:circular:landing": "madge --circular --extensions ts apps/landing/src",
    "check:circular:packages": "madge --circular --extensions ts packages/legal/src packages/model/src packages/money/src packages/pricing/src packages/time/src",
    "deps:fix": "syncpack fix",
    "deps:format": "syncpack format",
    "deps:lint": "syncpack lint",
    "deps:majors": "bun x npm-check-updates --workspaces --root --format group",
    "deps:up": "bun x npm-check-updates --workspaces --root --interactive",
    "deps:update": "bun x npm-check-updates --workspaces --root --target minor -u && bun install && bun run deps:fix",
    "dev": "turbo dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky",
    "test": "turbo test",
    "type-check": "turbo type-check"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
