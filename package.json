{
  "name": "sub-eye",
  "description": "A monorepo template for SubEye subscriptions management app",
  "version": "3.3.0-beta.8",
  "author": "Yehor Hunko",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260307.1",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "bun-types": "^1.3.10",
    "eslint": "9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "semantic-release": "^25.0.3",
    "syncpack": "^14.2.0",
    "turbo": "^2.8.14",
    "wrangler": "^4.71.0"
  },
  "homepage": "https://github.com/yhunko/sub-eye",
  "keywords": [
    "bun",
    "hono",
    "monorepo",
    "react",
    "turbo",
    "vite"
  ],
  "license": "MIT",
  "packageManager": "bun@1.3.10",
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:client": "turbo build --filter=client",
    "build:server": "turbo build --filter=server",
    "deploy:dev": "turbo build && wrangler -c dev.wrangler.jsonc deploy --minify",
    "deps:sync:lint": "syncpack lint",
    "deps:sync:up": "syncpack update",
    "deps:up": "bun x npm-check-updates --interactive",
    "dev": "turbo dev",
    "dev:client": "turbo dev --filter=client",
    "dev:server": "turbo dev --filter=server",
    "guidelines:check": "bun scripts/sync-agent-guidelines.mjs --check",
    "guidelines:sync": "bun scripts/sync-agent-guidelines.mjs",
    "lint": "turbo lint",
    "postinstall": "turbo build --filter=shared --filter=server",
    "prepare": "husky",
    "react-doctor": "bun x react-doctor@latest . --yes --project client --diff --offline --fail-on warning --verbose",
    "test": "turbo test",
    "type-check": "turbo type-check"
  },
  "workspaces": [
    "./server",
    "./client",
    "./shared"
  ]
}
