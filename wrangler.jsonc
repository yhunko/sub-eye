{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "subeye-dev", // Name of your project
  // Point Wrangler to TypeScript source so it can resolve tsconfig path aliases
  "main": "./server/src/index.ts", // Path to worker entry (TS)
  "compatibility_date": "2025-05-25",
  "assets": {
    "directory": "./client/dist", // Path to client build folder
    "not_found_handling": "single-page-application" // Handle SPA routing
  },
  // Ensure esbuild uses the monorepo tsconfig with path aliases
  "tsconfig": "./tsconfig.json",
  "compatibility_flags": ["nodejs_compat"] // Enable node for Vite path features
}
