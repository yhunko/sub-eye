{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!apps/mobile/src/shared/i18n/paraglide",
      "!apps/server/drizzle/meta",
      // Apple Icon Composer owns this bundle and regenerates it; its layer
      // SVGs are artwork, not accessible content.
      "!apps/mobile/icon.icon",
      "!!.claude",
      "!!.git",
      "!!.idea",
      "!!.wrangler",
      "!!**/dist",
      "!!**/build",
      "!!**/.turbo",
      "!!**/node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Services, repositories, controllers and mappers are static-only
        // classes used as namespaces — that is the server's layering, not an
        // accident. Enabling this flags all 12 of them.
        "noStaticOnlyClass": "off"
      },
      "correctness": {
        // Stricter than recommended: a stale hook dep in the mobile app shows
        // up as a screen that silently never refetches.
        "useExhaustiveDependencies": "error"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
