{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      // Generated by apps/landing/scripts/fetch-fonts.ts from Google's own
      // stylesheet — reformatting it just makes the next run a diff.
      "!apps/landing/src/styles/fonts.css",
      // Biome parses an .astro file's frontmatter but not its template, so
      // every const the markup renders reads as unused — 60+ false positives
      // and no real coverage. apps/landing runs `astro check` instead, which
      // understands both halves, and its tsconfig turns on `noUnusedLocals` so
      // the one rule worth keeping is not lost with it.
      "!**/*.astro",
      // Apple Icon Composer owns this bundle and regenerates it; its layer
      // SVGs are artwork, not accessible content.
      "!apps/ios/icon.icon",
      "!!.claude",
      "!!.git",
      "!!.idea",
      "!!.wrangler",
      "!!**/dist",
      "!!**/build",
      "!!**/.turbo",
      "!!**/node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // CurrencyUtils, DateTimezoneUtils and RecurrenceUtils are static-only
        // classes used as namespaces, deliberately.
        "noStaticOnlyClass": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      // The prefers-reduced-motion reset has to out-specify Astro's scoped
      // component styles, which carry a `[data-astro-cid-*]` attribute. There
      // is no selector that beats them without `!important`, and dropping the
      // reset would leave any future transition unguarded.
      "includes": ["apps/landing/src/styles/global.css"],
      "linter": {
        "rules": { "complexity": { "noImportantStyles": "off" } }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
